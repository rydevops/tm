{
  "name": "tropical-merge",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "description": "Tropical Merge: an offline-capable merge-3 island restoration game (HTML5 PWA).",
  "scripts": {
    "build:data": "node tools/build-data.mjs",
    "build:icons": "node tools/make-icons.mjs",
    "build:sw": "node tools/make-sw.mjs",
